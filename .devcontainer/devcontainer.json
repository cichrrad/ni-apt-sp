{
  "name": "APT-Ruby",
  "image": "mcr.microsoft.com/devcontainers/base:1-jammy",
  "runArgs": [
    "--cap-add=SYS_ADMIN",
    "--cap-add=SYS_PTRACE",
    "--security-opt", "seccomp=unconfined"
  ],
  "features": {
    "ghcr.io/devcontainers/features/ruby:1": {
      "version": "3.3",        
      "bundler": "latest"      
    }

  },
  "containerEnv": {
    "MPLBACKEND": "Agg"
  },
  "postCreateCommand": "bundle install",

  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "misogi.ruby-rubocop"
      ]
    }
  }
}
